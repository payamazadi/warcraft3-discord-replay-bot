# Discord bot token from https://discord.com/developers/applications (Bot -> Token)
TOKEN=

# Your in-game name or full battleTag (azadismind or azadismind#1665)
PLAYERNAME=azadismind

# The replay file to watch. Reforged saves it here after every game:
REPLAYLOCATION=C:\Users\payam\Documents\Warcraft III\BattleNet\<your-account-folder>\Replays\LastReplay.w3g

# Live stats service (wc3-re service/live-server.js). Every W/L lookup is
# fetched fresh from the running game — start it before playing:
#   cd wc3-re\service && node live-server.js
STATSURL=http://127.0.0.1:8080

# Channel IDs (right-click channel in Discord -> Copy ID, needs Developer Mode)
TESTINGCHANNELID=
REALCHANNELID=

# TESTING=1 -> post to TESTINGCHANNELID and allow parsing on startup
TESTING=0
# DRYRUN=1 -> no Discord login; prints what would be posted to the console
DRYRUN=0
